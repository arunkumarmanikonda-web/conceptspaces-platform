{
  "name": "conceptspaces-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*","packages/*"],
  "scripts": {
    "dev": "npm run dev -w @conceptspaces/web",
    "build": "npm run build -w @conceptspaces/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "accessibility": "node scripts/accessibility-gate.mjs"
  },
  "engines": {"node":">=22"}
}
